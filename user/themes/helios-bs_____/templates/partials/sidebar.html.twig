<div class="offcanvas-lg offcanvas-start hx-sidebar" tabindex="-1" id="hxSidebar" aria-label="Nawigacja">
    <div class="offcanvas-header d-lg-none">
        <span class="hx-brand"><span class="hx-logo"></span>{{ site.title }}</span>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#hxSidebar" aria-label="Zamknij"></button>
    </div>
    <div class="offcanvas-body flex-column">
        <nav class="hx-nav" id="hxNav">
            {% for section in pages.children.visible %}
                {% if section.children.visible.count %}
                    <details class="hx-group" {{ section.active or section.activeChild ? 'open' : '' }}>
                        <summary class="hx-group-title">
                            <span>{{ section.menu }}</span>
                            <svg class="hx-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                        </summary>
                        <ul class="list-unstyled mb-0 hx-group-list">
                            <li><a class="hx-nav-link {{ section.active ? 'active' : '' }}" href="{{ section.url }}">Przegląd</a></li>
                            {% for child in section.children.visible %}
                                {% if child.children.visible.count %}
                                    <li>
                                        <details class="hx-subgroup" {{ child.active or child.activeChild ? 'open' : '' }}>
                                            <summary class="hx-nav-link hx-sub-summary {{ child.active ? 'active' : '' }}">
                                                <span>{{ child.menu }}</span>
                                                <svg class="hx-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                                            </summary>
                                            <ul class="list-unstyled hx-nav-sub">
                                                <li><a class="hx-nav-link {{ child.active ? 'active' : '' }}" href="{{ child.url }}">Przegląd</a></li>
                                                {% for sub in child.children.visible %}
                                                    <li><a class="hx-nav-link {{ sub.active ? 'active' : '' }}" href="{{ sub.url }}">{{ sub.menu }}</a></li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    </li>
                                {% else %}
                                    <li><a class="hx-nav-link {{ child.active ? 'active' : '' }}" href="{{ child.url }}">{{ child.menu }}</a></li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </details>
                {% endif %}
            {% endfor %}

            {% set singles = [] %}
            {% for section in pages.children.visible %}
                {% if not section.children.visible.count and not section.home %}
                    {% set singles = singles|merge([section]) %}
                {% endif %}
            {% endfor %}
            {% if singles|length %}
                <div class="hx-group hx-singles">
                    <div class="hx-group-title static"><span>Więcej</span></div>
                    <ul class="list-unstyled mb-0 hx-group-list">
                        {% for s in singles %}
                            <li><a class="hx-nav-link {{ s.active ? 'active' : '' }}" href="{{ s.url }}">{{ s.menu }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </nav>
    </div>
</div>
