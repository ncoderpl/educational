{% extends 'partials/base.html.twig' %}

{% block body %}
{# --- GÓRNY PASEK NAWIGACYJNY (Tak samo jak w base.html.twig) --- #}
<header class="hx-topbar sticky-top">
    <div class="hx-topbar-inner d-flex align-items-center gap-2 gap-lg-3 px-3 px-lg-4">
        <button class="btn btn-sm hx-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#hxSidebar" aria-label="Menu">
            <span class="hx-burger"></span>
        </button>
        <a class="hx-brand" href="{{ base_url == '' ? '/' : base_url }}">
            <span class="hx-logo"></span><span class="d-none d-sm-inline">{{ site.title }}</span>
        </a>

        {# <div class="hx-search ms-lg-3 flex-grow-1">
            <input id="hxSearch" type="search" class="form-control form-control-sm" placeholder="Szukaj…" autocomplete="off">
            <span class="hx-kbd d-none d-md-inline"><kbd>Ctrl</kbd><kbd>K</kbd></span>
            <div id="hxSearchResults" class="hx-search-results d-none"></div>
        </div> #}

        {# Wymuszone górne menu #}
        <nav class="d-none d-md-flex align-items-center gap-3 ms-3">
            {% for p in pages.children %}
                <a class="hx-toplink {{ (p.active or p.activeChild) ? 'active' : '' }}" href="{{ p.url }}">
                    {{ p.menu|default(p.title) }}
                </a>
            {% endfor %}
        </nav>

        <nav class="d-none d-md-flex align-items-center gap-3 ms-auto">
            {% for link in config.theme.header_links %}
                <a class="hx-toplink" href="{{ link.url }}"{% if link.url starts with 'http' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
            {% endfor %}
        </nav>

        <div class="d-flex align-items-center gap-2 ms-auto ms-md-0">
            <button id="hxThemeToggle" class="btn btn-sm hx-icon-btn" type="button" title="Jasny / ciemny">
                <svg class="hx-ico-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                <svg class="hx-ico-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
        </div>
    </div>
</header>
{# --- KONIEC GÓRNEGO PASKA --- #}

<div class="hx-shell">
    {# Sprawdzamy sidebar - w pliku .md musi być włączony lub wyłączony #}
    {% if page.header.sidebar != false %}
        {% include 'partials/sidebar.html.twig' %}
    {% endif %}

    <main class="hx-main {% if page.header.sidebar == false %}w-100 px-4{% endif %}">

        {# Hero section ukryty lub nadpisany #}
        {% if page.header.hero_text %}
            <div class="hx-hero py-5 mb-4 border-bottom bg-light">
                <div class="container text-center">
                    <h1 class="display-5 fw-bold">{{ page.title }}</h1>
                    <p class="lead text-muted">{{ page.header.hero_text }}</p>
                </div>
            </div>
        {% else %}
             <div class="container mt-5">
                 <h1 class="mb-4">{{ page.title }}</h1>
             </div>
        {% endif %}

        <section class="container hx-home-body mt-2">
            {# Opcjonalna treść wpisana w pliku markdown nad listą #}
            <div class="doc-content mb-5">{{ page.content|raw }}</div>

            {# --- KAFELKI NA PEŁNĄ SZEROKOŚĆ (LISTING) --- #}
            <div class="row g-4 mb-5">
                {# Zamiast page.children używamy collection() tak, jak rekomenduje Grav dla stron typu listing #}
                {% set collection = page.collection() %}

                {% if collection|length > 0 %}
                    {% for course in collection %}
                        {# Używamy col-12, aby rozciągnąć kafelek na całą szerokość ekranu #}
                        <div class="col-12">
                            {# d-flex i align-items-center dla estetycznego ułożenia ikony i tekstu w rzędzie #}
                            <a href="{{ course.url }}" class="hx-card d-flex flex-column flex-md-row align-items-md-center position-relative p-4 border rounded shadow-sm text-decoration-none transition-hover h-100">

                                <div class="hx-card-icon fs-1 text-primary me-md-4 mb-3 mb-md-0">
                                    {{ course.header.icon ?: '📚' }}
                                </div>

                                <div class="flex-grow-1">
                                    <h3 class="h4 mb-2 text-body fw-bold">{{ course.title }}</h3>
                                    <p class="text-muted mb-0">{{ course.summary|striptags|slice(0, 250) ~ '->' }}</p>
                                </div>

                                <div class="ms-md-4 mt-3 mt-md-0 text-muted opacity-50 d-none d-md-block">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-info">W tym katalogu nie ma jeszcze żadnych podstron. Upewnij się, że w pliku listing.md zadeklarowałeś kolekcję (content: items: '@self.children').</div>
                {% endif %}
            </div>
        </section>

        <div class="container" style="max-width:1050px; margin-top: 50px;">
            {% include 'partials/footer.html.twig' %}
        </div>
    </main>
</div>
{% endblock %}