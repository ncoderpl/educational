<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}" data-bs-theme="dark">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#15151A">
        <title>{% if (page.header.seo_title ?: page.title) and not page.home %}{{ page.header.seo_title ?: page.title }} | {% endif %}{{ site.title }}</title>

        {% include 'partials/metadata.html.twig' %}

        {# Motyw ustawiany przed renderem, żeby nie migało #}
        <script>
            (function () {
                var t = null;
                try {
                    t = localStorage.getItem("hx-theme");
                } catch (e) {}
                if (!t)
                    t =
                        window.matchMedia &&
                        window.matchMedia("(prefers-color-scheme: light)").matches
                            ? "light"
                            : "dark";
                document.documentElement.setAttribute("data-bs-theme", t);
            })();
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
        <link href="{{ url('theme://css/theme.css') }}" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">

        <script defer src="https://unpkg.com/htmx.org@1.9.12"></script>

        <style>
            .htmx-indicator {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: transparent;
                z-index: 9999;
                opacity: 0;
                transition: opacity 0.2s ease-in;
                pointer-events: none;
            }
            .htmx-request.htmx-indicator {
                opacity: 1;
            }
            .htmx-request.htmx-indicator::before {
                content: "";
                display: block;
                height: 100%;
                background: linear-gradient(90deg, #8b7cff, #b1a8ff);
                animation: htmx-loading 1.2s infinite ease-in-out;
            }
            @keyframes htmx-loading {
                0% {
                    width: 0;
                    margin-left: 0;
                }
                50% {
                    width: 50%;
                    margin-left: 25%;
                }
                100% {
                    width: 0;
                    margin-left: 100%;
                }
            }
        </style>

        {# Główna mechanika SPA - Wykonuje się tylko raz #}
        <script>
            (function () {
                if (window.__eduInit) return;
                window.__eduInit = true;

                // --- Linki do plików: bez htmx, z pobieraniem ---
                function markFileLinks(root) {
                    if (!root || !root.querySelectorAll) return;
                    root.querySelectorAll(
                        'a[href$=".pptx"], a[href$=".pdf"], a[href$=".docx"], a[href$=".xlsx"], a[href$=".zip"]',
                    ).forEach(function (a) {
                        a.setAttribute("hx-boost", "false");
                        a.setAttribute("download", "");
                    });
                }

                document.addEventListener("DOMContentLoaded", function () {
                    if (window.htmx) htmx.onLoad(markFileLinks);
                });

                // --- Stan paska bocznego przed podmianą strony ---
                document.addEventListener("htmx:beforeSwap", function (event) {
                    if (!event.detail.boosted) return;
                    var sidebarBody = document.querySelector("#hxSidebar .offcanvas-body");
                    if (!sidebarBody) return;

                    try {
                        sessionStorage.setItem("hxSidebarScroll", sidebarBody.scrollTop);

                        var openFolders = [];
                        document
                            .querySelectorAll("#hxSidebar details[open] > summary")
                            .forEach(function (s) {
                                openFolders.push(s.textContent.trim());
                            });
                        sessionStorage.setItem(
                            "hxSidebarOpen",
                            JSON.stringify(openFolders),
                        );
                    } catch (e) {}
                });

                // --- Po podmianie strony ---
                document.addEventListener("htmx:afterSwap", function (event) {
                    if (!event.detail.boosted) return;

                    // Przywróć rozwinięte foldery
                    var openFolders = [];
                    try {
                        openFolders = JSON.parse(
                            sessionStorage.getItem("hxSidebarOpen") || "[]",
                        );
                    } catch (e) {}
                    document
                        .querySelectorAll("#hxSidebar details")
                        .forEach(function (detail) {
                            var summary = detail.querySelector("summary");
                            if (
                                summary &&
                                openFolders.indexOf(summary.textContent.trim()) !== -1
                            ) {
                                detail.setAttribute("open", "");
                            }
                        });

                    // Przywróć scroll paska
                    var sidebarBody = document.querySelector("#hxSidebar .offcanvas-body");
                    var savedScroll = null;
                    try {
                        savedScroll = sessionStorage.getItem("hxSidebarScroll");
                    } catch (e) {}
                    if (sidebarBody && savedScroll) {
                        setTimeout(function () {
                            sidebarBody.scrollTop = parseInt(savedScroll, 10);
                        }, 10);
                    }

                    // Treść na górę
                    window.scrollTo({ top: 0, behavior: "instant" });

                    // KaTeX
                    if (typeof katex !== "undefined") {
                        document.querySelectorAll("[data-m]").forEach(function (el) {
                            var m = el.getAttribute("data-m");
                            if (m)
                                katex.render(m, el, {
                                    displayMode: true,
                                    throwOnError: false,
                                });
                        });
                    }

                    // Zgodność z theme.js (TOC, czcionki) - tylko po nawigacji
                    document.dispatchEvent(
                        new Event("DOMContentLoaded", { bubbles: true, cancelable: true }),
                    );
                    window.dispatchEvent(new Event("load"));
                });
            })();
        </script>
    </head>

    <body hx-boost="true" hx-indicator="#hx-loader">

        <div id="hx-loader" class="htmx-indicator"></div>

        <header class="hx-topbar sticky-top">
            <div class="hx-topbar-inner d-flex align-items-center gap-2 gap-lg-3 px-3 px-lg-4">
                <button class="btn btn-sm hx-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#hxSidebar" aria-label="Menu">
                    <span class="hx-burger"></span>
                </button>
                <a class="hx-brand" href="{{ base_url == '' ? '/' : base_url }}">
                    <span class="hx-logo"></span><span class="d-none d-sm-inline">{{ site.title }}</span>
                </a>

                {# Kontener wyszukiwarki zachowany pomiędzy przeładowaniami dzięki hx-preserve #}
                {# <div id="hx-search-wrapper" class="hx-search ms-lg-3 flex-grow-1" hx-preserve="true">
                    <input id="hxSearch" type="search" class="form-control form-control-sm" placeholder="Szukaj…" autocomplete="off">
                    <span class="hx-kbd d-none d-md-inline"><kbd>Ctrl</kbd><kbd>K</kbd></span>
                    <div id="hxSearchResults" class="hx-search-results d-none"></div>
                </div> #}

                <nav class="d-none d-md-flex align-items-center gap-3 ms-3">
                    {% for p in pages.children %}
                        <a class="hx-toplink {{ (p.active or p.activeChild) ? 'active' : '' }}" href="{{ p.url }}">
                            {{ p.menu|default(p.title) }}
                        </a>
                    {% endfor %}
                </nav>

                <nav class="d-none d-md-flex align-items-center gap-3 ms-auto">
                    {% for link in config.theme.header_links %}
                        <a class="hx-toplink" href="{{ link.url }}"{% if link.url starts with 'http' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
                    {% endfor %}
                </nav>

                <div class="d-flex align-items-center gap-2 ms-auto ms-md-0">

                    {# Przycisk wylogowania - widoczny tylko dla zalogowanych użytkowników #}
                    {% if grav.user.authenticated %}
                        <a href="{{ uri.addNonce(base_url_relative ~ '/task:login.logout', 'logout-form', 'logout-nonce') }}" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" title="Zalogowany jako: {{ grav.user.username }}" hx-boost="false">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span class="d-none d-sm-inline">Wyloguj: {{ grav.user.username }}</span>
                            {{ dump(grav) }}
                        </a>
                    {% endif %}

                    <button id="hxThemeToggle" class="btn btn-sm hx-icon-btn" type="button" title="Jasny / ciemny" aria-label="Przełącz motyw">
                        <svg class="hx-ico-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        <svg class="hx-ico-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                </div>
            </div>
        </header>

        {% block body %}{% endblock %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ url('theme://js/theme.js') }}"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js"></script>
    </body>
</html>