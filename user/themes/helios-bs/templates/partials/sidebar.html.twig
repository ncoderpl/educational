<div class="offcanvas-lg offcanvas-start hx-sidebar edu-sidebar" tabindex="-1" id="hxSidebar" aria-label="Nawigacja">
    <div class="offcanvas-header d-lg-none">
        <span class="hx-brand"><span class="hx-logo"></span>{{ site.title }}</span>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#hxSidebar" aria-label="Zamknij"></button>
    </div>

    <div class="offcanvas-body flex-column p-0">
        {% for section in pages.children.visible %}
            {% if section.slug != 'home' and section.slug != 'blog' and (section.active or section.activeChild) %}

                {# --- Aktywny kurs (puste, gdy jesteśmy na liście wszystkich kursów) --- #}
                {% set active_course = section.children.visible|filter(c => c.active or c.activeChild)|first %}

                {# --- Wybór kursu: pełne przeładowanie strony (hx-boost="false") --- #}
                <div class="edu-courses">
                    <span class="edu-courses-title">Wybierz kurs</span>
                    <div class="edu-courses-grid">
                        {% for course in section.children.visible %}
                            <a
                                href="{{ course.url }}"
                                hx-boost="false"
                                class="edu-course-btn {{ course.active or course.activeChild ? 'active' : '' }}"
                            >{{ course.menu }}</a>
                        {% endfor %}
                    </div>
                </div>

                {# --- Nagłówek: nazwa kursu, a bez aktywnego kursu nazwa sekcji --- #}
                <div class="edu-brand">{{ active_course ? active_course.menu : section.menu }}</div>

                <nav class="edu-nav" id="hxNav">
                    <a class="edu-back" href="{{ base_url == '' ? '/courses' : base_url ~ '/courses' }}">&larr; Wróć do listy kursów</a>
                    {# --- Lekcje tylko aktywnego kursu --- #}
                    {% if active_course %}
                        <ul class="edu-list">
                            <li><a class="edu-link {{ active_course.active ? 'active' : '' }}" href="{{ active_course.url }}">Lista</a></li>

                            {% for child in active_course.children.visible %}
                                {% if child.children.visible.count %}
                                    <li>
                                        <details name="edu-sub-{{ active_course.slug }}" class="edu-sub" {{ child.active or child.activeChild ? 'open' : '' }}>
                                            <summary class="edu-link edu-summary {{ child.active ? 'active' : '' }}">
                                                <span><span class="edu-num">{{ loop.index }}.</span>{{ child.menu }}</span>
                                                <svg class="edu-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                                            </summary>
                                            <ul class="edu-list edu-sublist">
                                                <li><a class="edu-link {{ child.active ? 'active' : '' }}" href="{{ child.url }}">Lista wpisów</a></li>
                                                {% for sub in child.children.visible %}
                                                    <li><a class="edu-link {{ sub.active ? 'active' : '' }}" href="{{ sub.url }}"><span class="edu-num">{{ loop.index }}.</span>{{ sub.menu }}</a></li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    </li>
                                {% else %}
                                    <li><a class="edu-link {{ child.active ? 'active' : '' }}" href="{{ child.url }}"><span class="edu-num">{{ loop.index }}.</span>{{ child.menu }}</a></li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                </nav>

            {% endif %}
        {% endfor %}
    </div>
</div>
