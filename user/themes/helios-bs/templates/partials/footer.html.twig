<footer class="hx-footer">
    <div class="d-flex flex-wrap justify-content-between gap-2">
        <span>&copy; {{ 'now'|date('Y') }} {{ config.theme.copyright ?: site.title }}</span>
        <span class="hx-footer-links">
            {% for link in config.theme.footer_links %}
                <a href="{{ link.url }}"{% if link.url starts with 'http' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
            {% endfor %}
            <span>Powered by <a href="https://getgrav.org" target="_blank" rel="noopener">Grav</a> + nCoder Theme</span>
        </span>
    </div>
</footer>
