<aside class="hx-blog-sidebar sticky-top" style="top: 100px; padding: 20px; background: rgba(0,0,0,0.02); border-radius: 8px;">
    <h4 class="mb-3 border-bottom pb-2">Dane wpisu</h4>
    <div class="text-muted mb-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1 mb-1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        {{ page.date|date("d.m.Y") }}
        {% include "partials/readtime.html.twig" %}
        {% if page.taxonomy.category %}
            <div class="mb-3">
                {% for cat in page.taxonomy.category %}
                    <a href="{{ page.parent.url }}/category{{ config.system.param_sep }}{{ cat }}" class="badge bg-primary text-white text-decoration-none px-2 py-1 me-1">
                        {{ cat }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {# Ustalamy główny folder z wpisami #}
    {% set news_folder = page.template == 'item' ? page.parent : page %}

    <!-- Sekcja 1: Kategorie -->
    <h4 class="mb-3 border-bottom pb-2">Kategorie</h4>
    <ul class="list-unstyled mb-4">
        {% set categories = [] %}
        {% for post in news_folder.children.visible %}
            {% if post.taxonomy.category %}
                {% for cat in post.taxonomy.category %}
                    {% if cat not in categories %}
                        {% set categories = categories|merge([cat]) %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        {% for category in categories|sort %}
            <li>
                <a href="{{ news_folder.url }}/category{{ config.system.param_sep }}{{ category }}" class="text-decoration-none">
                    {{ category|capitalize }}
                </a>
            </li>
        {% else %}
            <li><span class="text-muted small">Brak kategorii</span></li>
        {% endfor %}
    </ul>

    <!-- Sekcja 2: Najpopularniejsze (wtyczka count-views) -->
    <h4 class="mb-3 border-bottom pb-2">Najpopularniejsze</h4>
    <ul class="list-unstyled">

        {# Folder z wpisami. Zmień '/news' na swoją ścieżkę, jeśli masz inną #}
        {% set news_folder = news_folder ?? page.find('/news') %}

        {# KROK 1: Zbieramy wpisy z liczbą wyświetleń ze zmiennej viewcounts #}
        {% set posts_with_views = {} %}
        {% if news_folder %}
            {% for post in news_folder.children.visible %}
                {% set views = (viewcounts[post.route] ?? 0)|number_format(0, '', '') %}
                {% set sort_key = "%08d"|format(views) ~ '-' ~ post.slug %}
                {% set posts_with_views = posts_with_views|merge({ (sort_key): post }) %}
            {% endfor %}
        {% endif %}

        {# KROK 2: Sortujemy klucze malejąco i bierzemy Top 5 #}
        {% set top_keys = posts_with_views|keys|sort|reverse|slice(0, 5) %}

        {# KROK 3: Wyświetlamy #}
        {% for key in top_keys %}
            {% set post = posts_with_views[key] %}
            {% set views = viewcounts[post.route] ?? 0 %}
            <li class="mb-3">
                <a href="{{ post.url }}" class="text-decoration-none fw-bold d-block">{{ post.title }}</a>
                <span class="small text-muted d-flex align-items-center gap-1 mt-1">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-75"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    {{ views }} wyświetleń
                </span>
            </li>
        {% else %}
            <li><span class="text-muted small">Brak wpisów.</span></li>
        {% endfor %}

    </ul>

</aside>
