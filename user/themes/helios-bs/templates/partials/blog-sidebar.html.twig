<aside class="hx-blog-sidebar sticky-top" style="top: 100px; padding: 20px; background: rgba(0,0,0,0.02); border-radius: 8px;">
    
    <h4 class="mb-3 border-bottom pb-2">Kategorie</h4>
    <ul class="list-unstyled mb-4">
        {# page.parent.url (dla pojedynczego wpisu) lub page.url (dla głównej listy) gwarantuje odpowiednią ścieżkę językową #}
        {% set base_news_url = page.template == 'item' ? page.parent.url : page.url %}
        
        <li><a href="{{ base_news_url }}/category{{ config.system.param_sep }}wydarzenia" class="text-decoration-none">Wydarzenia</a></li>
        <li><a href="{{ base_news_url }}/category{{ config.system.param_sep }}szkola" class="text-decoration-none">Szkoła</a></li>
        <li><a href="{{ base_news_url }}/category{{ config.system.param_sep }}ogloszenia" class="text-decoration-none">Ogłoszenia</a></li>
    </ul>

    <h4 class="mb-3 border-bottom pb-2">Ostatnie wpisy</h4>
    <ul class="list-unstyled">
        {# Wyszukuje wpisy dynamicznie z obecnego katalogu #}
        {% set news_folder = page.template == 'item' ? page.parent : page %}
        {% set recent = news_folder.children.visible.order('date', 'desc').slice(0, 3) %}
        
        {% for post in recent %}
            <li class="mb-3">
                <a href="{{ post.url }}" class="text-decoration-none fw-bold d-block">{{ post.title }}</a>
                <span class="small text-muted">{{ post.date|date("d.m.Y") }}</span>
            </li>
        {% endfor %}
    </ul>
    
</aside>