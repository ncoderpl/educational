{% extends 'partials/base.html.twig' %}

{% block body %}
    <div class="hx-shell" style="max-width: none !important; width: 100% !important; margin: 0; padding: 0;">
    
        {% if page.header.sidebar != false %}
            {% include 'partials/sidebar.html.twig' %}
        {% endif %}
    
        <main class="hx-main" style="{% if page.header.sidebar == false %}margin-left: 0 !important;{% endif %} max-width: none !important; width: 100% !important; padding: 0 5%; flex: 1;">
        
            <div class="row mt-5" style="width: 100%; margin: 0;">
            
                {# --- LEWA KOLUMNA: TREŚĆ ARTYKUŁU --- #}
                <div class="col-lg-8 col-xl-9 px-0 px-lg-4">
                    <article style="max-width: 800px; margin-left: 0; margin-right: auto;">
                    
                        <header class="mb-5 border-bottom pb-4">
                            <div class="text-muted mb-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1 mb-1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                {{ page.date|date("d.m.Y") }}
                            </div>
                        
                            <h1 class="display-4 fw-bold mb-3">{{ page.title }}</h1>
                        
                            {% if page.taxonomy.category %}
                                <div class="mt-3">
                                    {% for cat in page.taxonomy.category %}
                                        <a href="{{ page.parent.url }}/category{{ config.system.param_sep }}{{ cat }}" class="badge bg-primary text-white text-decoration-none px-2 py-1 me-1">
                                            {{ cat }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </header>

                        <div class="doc-content fs-5" style="line-height: 1.8;">
                            {{ page.content|raw }}
                        </div>
                    
                        <footer class="mt-5 pt-4 border-top">
                            <a href="{{ page.parent.url }}" class="btn btn-outline-secondary">
                                &larr; Powrót do wpisów
                            </a>
                        </footer>

                    </article>
                </div>

                {# --- PRAWA KOLUMNA: SIDEBAR --- #}
                <div class="col-lg-4 col-xl-3 mt-5 mt-lg-0">
                    {% include 'partials/blog-sidebar.html.twig' %}
                </div>
            
            </div>

            <div style="width: 100%; border-top: 1px solid rgba(0,0,0,0.1); padding-top: 20px; margin-top: 50px;">
                {% include 'partials/footer.html.twig' %}
            </div>
        
        </main>
    </div>
{% endblock %}
